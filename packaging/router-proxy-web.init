#!/bin/sh /etc/rc.common

START=96
STOP=14
USE_PROCD=1

LAUNCHER=/data/router-proxy-web/launcher.sh

start_service() {
    [ -x "$LAUNCHER" ] || {
        logger -t router-proxy-web "launcher is missing: $LAUNCHER"
        return 1
    }

    procd_open_instance
    procd_set_param command "$LAUNCHER"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    stop
    start
}
