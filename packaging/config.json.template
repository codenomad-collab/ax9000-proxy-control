{
  "listen": "__LISTEN_ADDRESS__",
  "mode_command": "/usr/bin/router-proxy-mode",
  "mode_file": "/data/router_proxy_mode",
  "shellcrash_config_paths": [
    "/tmp/ShellCrash/config.yaml"
  ],
  "mihomo_controller_url": "http://127.0.0.1:9097",
  "conntrack_paths": [
    "/proc/net/nf_conntrack",
    "/proc/net/ip_conntrack"
  ],
  "ipset_command": "/usr/sbin/ipset",
  "logread_command": "/sbin/logread",
  "node_guard_command": "",
  "node_guard_state_path": "",
  "node_guard_log_path": "",
  "node_guard_cron_path": "/etc/crontabs/root",
  "network_config_path": "/etc/config/network",
  "mesh_config_path": "/etc/config/xiaoqiang",
  "mesh_nodes_path": "",
  "wan_interface": "",
  "external_storage": "__EXTERNAL_STORAGE__",
  "password_salt": "__PASSWORD_SALT__",
  "password_sha256": "__PASSWORD_SHA256__",
  "session_ttl_minutes": 720,
  "max_sessions": 300,
  "max_log_lines": 250,
  "auto_rollback": true
}
